# Server-side only. Never prefix these variables with VITE_.
RESEND_API_KEY=
BOOKING_EMAIL_TO=
# Sender address on a domain verified in Resend
BOOKING_EMAIL_FROM=

# Optional analytics: leave both empty to disable tracking.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional: required only for the two images still in Manus storage.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
